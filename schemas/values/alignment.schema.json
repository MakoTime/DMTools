{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/alignment.schema.json",
    "title": "D&D 5e Alignment",
    "description": "A creature's alignment.",
    "$comment": "version 0.5.0",
    "oneOf": [
        {
            "type": "object",
            "properties": {
                "order": {
                    "type": "string",
                    "enum": [
                        "lawful",
                        "neutral",
                        "chaotic"
                    ]
                },
                "morality": {
                    "type": "string",
                    "enum": [
                        "good",
                        "neutral",
                        "evil"
                    ]
                }
            },
            "minProperties": 1,
            "anyOf": [
                {
                    "required": [
                        "order"
                    ]
                },
                {
                    "required": [
                        "morality"
                    ]
                }
            ],
            "additionalProperties": false
        },
        {
            "type": "string",
            "enum": [
                "unaligned",
                "any"
            ]
        }
    ]
}