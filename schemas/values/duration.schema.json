{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/duration.schema.json",
    "title": "D&D 5e Duration Unit",
    "description": "How long an effect lasts. Use recharge.schema.json for recovery timing.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "instantaneous",
                "until_dispelled",
                "until_saved",
                "round",
                "next_round",
                "minute",
                "hour",
                "day",
                "week",
                "month",
                "year"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
