{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/size.schema.json",
    "title": "D&D 5e Creature Size",
    "description": "A creature size category.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "tiny",
                "small",
                "medium",
                "large",
                "huge",
                "gargantuan"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
