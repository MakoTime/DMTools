{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/condition.schema.json",
    "title": "D&D 5e Condition",
    "description": "A condition that can affect a creature.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "blinded",
                "charmed",
                "deafened",
                "exhaustion",
                "frightened",
                "grappled",
                "incapacitated",
                "invisible",
                "paralyzed",
                "petrified",
                "poisoned",
                "prone",
                "restrained",
                "stunned",
                "unconscious"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
