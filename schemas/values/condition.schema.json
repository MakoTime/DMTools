{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "condition.schema.json",
    "title": "D&D 5e Condition",
    "description": "Defines a condition that can affect a creature.",
    "type": "string",
    "enum": [
        "blinded",
        "charmed",
        "deafened",
        "frightened",
        "grappled",
        "incapacitated",
        "invisible",
        "paralyzed",
        "petrified",
        "poisoned",
        "prone",
        "restrained",
        "stunned",
        "unconscious"
    ]
}