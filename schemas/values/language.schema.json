{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/language.schema.json",
    "title": "D&D 5e Language",
    "description": "A language. Canonical languages are listed; custom languages are allowed.",
    "$comment": "version 0.5.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "common",
                "dwarvish",
                "elvish",
                "giant",
                "gnomish",
                "goblin",
                "halfling",
                "orc",
                "abyssal",
                "celestial",
                "draconic",
                "deep_speech",
                "infernal",
                "primordial",
                "sylvan",
                "undercommon"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}