{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/action_type.schema.json",
    "title": "D&D 5e Action Type",
    "description": "The type of action used by a creature or feature.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "action",
                "bonus_action",
                "reaction",
                "free_action",
                "legendary_action",
                "lair_action",
                "mythic_action"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
