{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "feature.schema.json",
    "title": "D&D 5e Feature",
    "description": "A feature or trait granted by a class, race, background, feat, or other game element.",
    "$comment": "version 0.3.0",
    "type": "object",
    "required": [
        "name",
        "description"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "source": {
            "$ref": "source.schema.json"
        }
    },
    "additionalProperties": false
}