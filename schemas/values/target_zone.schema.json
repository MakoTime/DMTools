{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/target_zone.schema.json",
    "title": "D&D 5e Target Zone",
    "description": "The shape or scope of an action or spell's area.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "single",
                "line",
                "cone",
                "cube",
                "cylinder",
                "sphere"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
