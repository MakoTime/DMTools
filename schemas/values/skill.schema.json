{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/skill.schema.json",
    "title": "D&D 5e Skill",
    "description": "A skill.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "acrobatics",
                "animal_handling",
                "arcana",
                "athletics",
                "deception",
                "history",
                "insight",
                "intimidation",
                "investigation",
                "medicine",
                "nature",
                "perception",
                "performance",
                "persuasion",
                "religion",
                "sleight_of_hand",
                "stealth",
                "survival"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
