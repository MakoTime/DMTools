{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "class_name.schema.json",
    "title": "JSON Schema for D&D 5e Class Name",
    "description": "This schema describes a D&D 5e class name.",
    "$comment": "version 0.2.0",
    "type": "string",
    "enum": [
        "artificer",
        "barbarian",
        "bard",
        "blood hunter",
        "cleric",
        "druid",
        "fighter",
        "monk",
        "paladin",
        "ranger",
        "rogue",
        "sorcerer",
        "warlock",
        "wizard"
    ]
}