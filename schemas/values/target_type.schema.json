{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/target_type.schema.json",
    "title": "D&D 5e Target Type",
    "description": "The kind of creature or object that can be targeted.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
