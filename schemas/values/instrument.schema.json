{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/instrument.schema.json",
    "title": "D&D 5e Musical Instrument",
    "description": "A musical instrument.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "bagpipes",
                "drum",
                "dulcimer",
                "flute",
                "lute",
                "lyre",
                "horn",
                "pan_flute",
                "shawm",
                "viol"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
