{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/damage_type.schema.json",
    "title": "D&D 5e Damage Type",
    "description": "A damage type.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "acid",
                "bludgeoning",
                "cold",
                "fire",
                "force",
                "lightning",
                "necrotic",
                "piercing",
                "poison",
                "psychic",
                "radiant",
                "slashing",
                "thunder"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
