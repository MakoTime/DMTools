{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "spell_school.schema.json",
    "title": "JSON Schema for D&D 5e Spell School",
    "description": "This schema describes a D&D 5e spell school.",
    "$comment": "version 0.2.0",
    "type": "string",
    "enum": [
        "abjuration",
        "chronomancy",
        "conjuration",
        "divination",
        "dunamancy",
        "enchantment",
        "evocation",
        "illusion",
        "necromancy",
        "transmutation"
    ]
}