{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "values/spell_school.schema.json",
    "title": "D&D 5e Spell School",
    "description": "A school of magic. Canonical schools are listed; custom schools are allowed.",
    "$comment": "version 0.4.0",
    "anyOf": [
        {
            "type": "string",
            "enum": [
                "abjuration",
                "chronomancy",
                "conjuration",
                "divination",
                "dunamancy",
                "enchantment",
                "evocation",
                "illusion",
                "necromancy",
                "transmutation"
            ]
        },
        {
            "$ref": "custom_value.schema.json"
        }
    ]
}
