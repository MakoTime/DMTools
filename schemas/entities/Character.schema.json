{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Character.schema.json",
    "title": "D&D 5e Character",
    "description": "A player character in play. Extends Creature. Class levels are instance data, not class definitions.",
    "$comment": "version 0.4.0",
    "type": "object",
    "allOf": [
        {
            "$ref": "Creature.schema.json"
        }
    ],
    "required": [
        "race",
        "classes",
        "ability_scores"
    ],
    "properties": {
        "xp": {
            "type": "integer",
            "minimum": 0,
            "default": 0
        },
        "race": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "subtype": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "classes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "../components/class_progression.schema.json"
            }
        },
        "background": {
            "type": "string",
            "minLength": 1
        },
        "equipment": {
            "type": "array",
            "items": {
                "$ref": "Equipment.schema.json"
            }
        }
    }
}
