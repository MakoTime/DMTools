{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Monster.schema.json",
    "title": "D&D 5e Monster",
    "description": "A monster stat block. Extends Creature.",
    "$comment": "version 0.5.0",
    "type": "object",
    "allOf": [
        {
            "$ref": "Creature.schema.json"
        }
    ],
    "required": [
        "challenge_rating"
    ],
    "properties": {
        "challenge_rating": {
            "type": "number",
            "minimum": 0,
            "examples": [
                0,
                0.125,
                0.25,
                0.5,
                1,
                2,
                13,
                21
            ]
        }
    }
}