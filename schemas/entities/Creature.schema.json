{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Creature.schema.json",
    "title": "D&D 5e Creature",
    "description": "A creature in play, including player characters, NPCs, and monsters. Left open so Character and Monster may add fields.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "size": {
            "$ref": "../values/size.schema.json"
        },
        "creature_type": {
            "$ref": "../values/creature_type.schema.json"
        },
        "alignment": {
            "$ref": "../values/alignment.schema.json"
        },
        "ability_scores": {
            "$ref": "../components/ability_scores.schema.json"
        },
        "hit_points": {
            "$ref": "../components/hit_points.schema.json"
        },
        "hit_dice": {
            "$ref": "../components/hit_dice.schema.json"
        },
        "armor_class": {
            "type": "object",
            "required": [
                "value"
            ],
            "properties": {
                "value": {
                    "type": "integer",
                    "minimum": 0
                },
                "description": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "movement": {
            "type": "array",
            "items": {
                "$ref": "../components/movement.schema.json"
            }
        },
        "saving_throws": {
            "$ref": "../components/saving_throws.schema.json"
        },
        "skills": {
            "type": "object",
            "additionalProperties": {
                "type": "integer"
            }
        },
        "senses": {
            "type": "array",
            "items": {
                "$ref": "../components/sense.schema.json"
            }
        },
        "languages": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "proficiency_bonus": {
            "type": "integer",
            "minimum": 0
        },
        "condition_immunities": {
            "type": "array",
            "items": {
                "$ref": "../values/condition.schema.json"
            },
            "uniqueItems": true
        },
        "damage_immunities": {
            "type": "array",
            "items": {
                "$ref": "../values/damage_type.schema.json"
            },
            "uniqueItems": true
        },
        "damage_resistances": {
            "type": "array",
            "items": {
                "$ref": "../values/damage_type.schema.json"
            },
            "uniqueItems": true
        },
        "damage_vulnerabilities": {
            "type": "array",
            "items": {
                "$ref": "../values/damage_type.schema.json"
            },
            "uniqueItems": true
        },
        "features": {
            "type": "array",
            "items": {
                "$ref": "../components/feature.schema.json"
            }
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "../components/action.schema.json"
            }
        },
        "reactions": {
            "type": "array",
            "items": {
                "$ref": "../components/action.schema.json"
            }
        },
        "legendary_actions": {
            "type": "array",
            "items": {
                "$ref": "../components/action.schema.json"
            }
        },
        "spell_slots": {
            "type": "array",
            "items": {
                "$ref": "../components/spell_slot.schema.json"
            }
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "image": {
            "$ref": "../components/image.schema.json"
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    }
}
