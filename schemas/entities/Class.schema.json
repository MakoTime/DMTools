{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Class.schema.json",
    "title": "D&D 5e Class",
    "description": "A character class definition in the catalog, not a level on a character sheet.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name",
        "hit_die"
    ],
    "properties": {
        "name": {
            "$ref": "../values/class_name.schema.json"
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "hit_die": {
            "$ref": "../values/die.schema.json"
        },
        "primary_abilities": {
            "type": "array",
            "items": {
                "$ref": "../values/ability_score.schema.json"
            },
            "uniqueItems": true
        },
        "saving_throws": {
            "type": "array",
            "items": {
                "$ref": "../values/ability_score.schema.json"
            },
            "uniqueItems": true
        },
        "armor_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/armor_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "weapon_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../components/weapon_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "tool_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/tool.schema.json"
            },
            "uniqueItems": true
        },
        "skill_choices": {
            "$ref": "../components/skill_choice.schema.json"
        },
        "features": {
            "type": "array",
            "items": {
                "$ref": "../components/feature.schema.json"
            }
        },
        "spellcasting": {
            "$ref": "../components/spellcasting.schema.json"
        },
        "subclass_level": {
            "description": "Class level at which a subclass is chosen.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 3
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "../values/tag.schema.json"
            },
            "uniqueItems": true
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}
