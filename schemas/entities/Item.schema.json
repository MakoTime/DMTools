{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Item.schema.json",
    "title": "D&D 5e Item",
    "description": "An item in the catalog.",
    "$comment": "version 0.5.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "category": {
            "$ref": "../values/item_category.schema.json"
        },
        "weapon": {
            "$ref": "../components/weapon.schema.json"
        },
        "armor": {
            "$ref": "../components/armor.schema.json"
        },
        "magic_item": {
            "$ref": "../components/magic_item.schema.json"
        },
        "weight": {
            "type": "number",
            "minimum": 0
        },
        "cost": {
            "$ref": "../components/cost.schema.json"
        },
        "features": {
            "type": "array",
            "items": {
                "$ref": "../components/feature.schema.json"
            }
        },
        "source": {
            "$ref": "../values/source.schema.json"
        },
        "image": {
            "$ref": "../components/image.schema.json"
        }
    },
    "additionalProperties": false
}