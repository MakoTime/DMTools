{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Background.schema.json",
    "title": "D&D 5e Background",
    "description": "A character background in the catalog.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "skill_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/skill.schema.json"
            },
            "uniqueItems": true
        },
        "tool_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/tool.schema.json"
            },
            "uniqueItems": true
        },
        "languages": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "features": {
            "type": "array",
            "items": {
                "$ref": "../components/feature.schema.json"
            }
        },
        "equipment": {
            "type": "array",
            "items": {
                "$ref": "Equipment.schema.json"
            }
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "../values/tag.schema.json"
            },
            "uniqueItems": true
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}
