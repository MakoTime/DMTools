{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Spell.schema.json",
    "title": "D&D 5e Spell",
    "description": "A spell in the catalog.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name",
        "description",
        "level",
        "casting_time",
        "components",
        "duration"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "higher_level": {
            "type": "string",
            "input": "textarea"
        },
        "level": {
            "$ref": "../values/spell_level.schema.json"
        },
        "school": {
            "$ref": "../values/spell_school.schema.json"
        },
        "classes": {
            "description": "Class lists that include this spell.",
            "type": "array",
            "items": {
                "$ref": "../values/class_name.schema.json"
            },
            "uniqueItems": true
        },
        "casting_time": {
            "$ref": "../components/casting_time.schema.json"
        },
        "target": {
            "$ref": "../components/target.schema.json"
        },
        "components": {
            "type": "array",
            "items": {
                "$ref": "../values/spell_component.schema.json"
            },
            "uniqueItems": true
        },
        "material": {
            "$ref": "../components/material_component.schema.json"
        },
        "ritual": {
            "type": "boolean",
            "default": false
        },
        "concentration": {
            "type": "boolean",
            "default": false
        },
        "duration": {
            "$ref": "../components/duration_amount.schema.json"
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "../components/effect.schema.json"
            }
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "../values/tag.schema.json"
            },
            "uniqueItems": true
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}
