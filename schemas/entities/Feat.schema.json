{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Feat.schema.json",
    "title": "D&D 5e Feat",
    "description": "A feat in the catalog.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "prerequisite": {
            "type": "string"
        },
        "ability_score_increases": {
            "type": "array",
            "items": {
                "$ref": "../components/ability_score_increase.schema.json"
            }
        },
        "skill_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/skill.schema.json"
            },
            "uniqueItems": true
        },
        "tool_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/tool.schema.json"
            },
            "uniqueItems": true
        },
        "vehicle_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/vehicle.schema.json"
            },
            "uniqueItems": true
        },
        "instrument_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/instrument.schema.json"
            },
            "uniqueItems": true
        },
        "gaming_set_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/gaming_set.schema.json"
            },
            "uniqueItems": true
        },
        "weapon_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../components/weapon_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "armor_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/armor_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "spells": {
            "type": "array",
            "items": {
                "$ref": "../components/spell_grant.schema.json"
            }
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "../components/action.schema.json"
            }
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "../values/tag.schema.json"
            },
            "uniqueItems": true
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}
