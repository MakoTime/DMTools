{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "Feat.schema.json",
    "title": "D&D 5e Feat",
    "description": "This schema describes a character feat.",
    "$comment": "version 0.3.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "ability_score_increases": {
            "description": "Ability score increases granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "ability_score_increase.schema.json"
            }
        },
        "skill_proficiencies": {
            "description": "Skill proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "skill.schema.json"
            },
            "uniqueItems": true
        },
        "tool_proficiencies": {
            "description": "Tool proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "tool.schema.json"
            },
            "uniqueItems": true
        },
        "vehicle_proficiencies": {
            "description": "Vehicle proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "vehicle.schema.json"
            },
            "uniqueItems": true
        },
        "instrument_proficiencies": {
            "description": "Instrument proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "instrument.schema.json"
            },
            "uniqueItems": true
        },
        "weapon_proficiencies": {
            "description": "Weapon proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "weapon_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "armor_proficiencies": {
            "description": "Armor proficiencies granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "../values/armor_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "spells": {
            "description": "Spells granted or selected by this feat.",
            "type": "array",
            "items": {
                "$ref": "../components/spell_grant.schema.json"
            }
        },
        "actions": {
            "description": "Actions granted by this feat.",
            "type": "array",
            "items": {
                "$ref": "action.schema.json"
            }
        },
        "source": {
            "$ref": "source.schema.json"
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "tag.schema.json"
            },
            "uniqueItems": true
        }
    },
    "additionalProperties": false
}