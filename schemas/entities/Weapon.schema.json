{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Weapon.schema.json",
    "title": "D&D 5e Weapon",
    "description": "A weapon in the catalog. Extends Item.",
    "$comment": "version 0.4.0",
    "type": "object",
    "allOf": [
        {
            "$ref": "Item.schema.json"
        }
    ],
    "required": [
        "damage",
        "category"
    ],
    "properties": {
        "category": {
            "$ref": "../values/weapon_category.schema.json"
        },
        "weapon_type": {
            "$ref": "../values/weapon_type.schema.json"
        },
        "damage": {
            "$ref": "../components/damage.schema.json"
        },
        "versatile_damage": {
            "$ref": "../components/damage.schema.json"
        },
        "range": {
            "$ref": "../components/range.schema.json"
        },
        "throw_range": {
            "$ref": "../components/range.schema.json"
        },
        "properties": {
            "type": "array",
            "items": {
                "$ref": "../values/weapon_tag.schema.json"
            },
            "uniqueItems": true
        }
    }
}
