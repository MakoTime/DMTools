{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Race.schema.json",
    "title": "D&D 5e Race",
    "description": "A playable race or subrace in the catalog.",
    "$comment": "version 0.5.0",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "examples": [
                "Dragonborn"
            ]
        },
        "subtype": {
            "type": "string",
            "minLength": 1,
            "examples": [
                "Silver"
            ]
        },
        "size": {
            "$ref": "../values/size.schema.json"
        },
        "movement": {
            "type": "array",
            "items": {
                "$ref": "../components/movement.schema.json"
            }
        },
        "ability_score_increases": {
            "type": "array",
            "items": {
                "$ref": "../components/ability_score_increase.schema.json"
            }
        },
        "features": {
            "type": "array",
            "items": {
                "$ref": "../components/feature.schema.json"
            }
        },
        "actions": {
            "type": "array",
            "description": "Special actions gained by the race or subtype.",
            "items": {
                "$ref": "../components/action.schema.json"
            }
        },
        "skill_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/skill.schema.json"
            },
            "uniqueItems": true
        },
        "weapon_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../components/weapon_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "armor_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/armor_proficiency.schema.json"
            },
            "uniqueItems": true
        },
        "tool_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/tool.schema.json"
            },
            "uniqueItems": true
        },
        "vehicle_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/vehicle.schema.json"
            },
            "uniqueItems": true
        },
        "instrument_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/instrument.schema.json"
            },
            "uniqueItems": true
        },
        "gaming_set_proficiencies": {
            "type": "array",
            "items": {
                "$ref": "../values/gaming_set.schema.json"
            },
            "uniqueItems": true
        },
        "languages": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "spell_grants": {
            "type": "array",
            "items": {
                "$ref": "../components/spell_grant.schema.json"
            }
        },
        "feats": {
            "description": "Names of feats granted by this race.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "senses": {
            "type": "array",
            "items": {
                "$ref": "../components/sense.schema.json"
            }
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}