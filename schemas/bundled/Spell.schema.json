{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "entities/Spell.schema.json",
    "title": "D&D 5e Spell",
    "description": "A spell in the catalog.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name",
        "description",
        "level",
        "casting_time",
        "components",
        "duration"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "higher_level": {
            "type": "string",
            "input": "textarea"
        },
        "level": {
            "$ref": "#/$defs/spell_level"
        },
        "school": {
            "$ref": "#/$defs/spell_school"
        },
        "classes": {
            "description": "Class lists that include this spell.",
            "type": "array",
            "items": {
                "$ref": "#/$defs/class_name"
            },
            "uniqueItems": true
        },
        "casting_time": {
            "$ref": "#/$defs/casting_time"
        },
        "target": {
            "$ref": "#/$defs/target"
        },
        "components": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/spell_component"
            },
            "uniqueItems": true
        },
        "material": {
            "$ref": "#/$defs/material_component"
        },
        "ritual": {
            "type": "boolean",
            "default": false
        },
        "concentration": {
            "type": "boolean",
            "default": false
        },
        "duration": {
            "$ref": "#/$defs/duration_amount"
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/effect"
            }
        },
        "roll_table": {
            "$ref": "#/$defs/roll_table"
        },
        "tags": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/tag"
            },
            "uniqueItems": true
        },
        "source": {
            "$ref": "#/$defs/source"
        },
        "grants": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/grant"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "spell_level": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/spell_level.schema.json",
            "title": "D&D 5e Spell Level",
            "description": "A spell level, where 0 is a cantrip.",
            "$comment": "version 0.4.0",
            "type": "integer",
            "minimum": 0,
            "maximum": 9
        },
        "spell_school": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/spell_school.schema.json",
            "title": "D&D 5e Spell School",
            "description": "A school of magic. Canonical schools are listed; custom schools are allowed.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "abjuration",
                        "chronomancy",
                        "conjuration",
                        "divination",
                        "dunamancy",
                        "enchantment",
                        "evocation",
                        "illusion",
                        "necromancy",
                        "transmutation"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "custom_value": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/custom_value.schema.json",
            "title": "Custom Value",
            "description": "A homebrew or otherwise non-canonical string value.",
            "$comment": "version 0.4.0",
            "type": "string",
            "minLength": 1
        },
        "class_name": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/class_name.schema.json",
            "title": "D&D 5e Class Name",
            "description": "A character class name. Canonical names are listed; custom classes are allowed.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "artificer",
                        "barbarian",
                        "bard",
                        "blood_hunter",
                        "cleric",
                        "druid",
                        "fighter",
                        "monk",
                        "paladin",
                        "ranger",
                        "rogue",
                        "sorcerer",
                        "warlock",
                        "wizard"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "casting_time": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/casting_time.schema.json",
            "title": "D&D 5e Casting Time",
            "description": "How long it takes to cast a spell.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "unit"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "unit": {
                    "type": "string",
                    "enum": [
                        "action",
                        "bonus_action",
                        "reaction",
                        "round",
                        "minute",
                        "hour"
                    ]
                }
            },
            "if": {
                "properties": {
                    "unit": {
                        "enum": [
                            "round",
                            "minute",
                            "hour"
                        ]
                    }
                },
                "required": [
                    "unit"
                ]
            },
            "then": {
                "required": [
                    "amount"
                ]
            },
            "additionalProperties": false
        },
        "target": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/target.schema.json",
            "title": "D&D 5e Target",
            "description": "A target specification for an action or spell.",
            "$comment": "version 0.5.0",
            "type": "object",
            "required": [
                "targeting"
            ],
            "properties": {
                "targeting": {
                    "type": "string",
                    "enum": [
                        "self",
                        "touch",
                        "range"
                    ]
                },
                "range": {
                    "$ref": "#/$defs/distance"
                },
                "type": {
                    "$ref": "#/$defs/target_type"
                },
                "count": {
                    "$ref": "#/$defs/target_count"
                },
                "zone": {
                    "type": "object",
                    "required": [
                        "type",
                        "size"
                    ],
                    "properties": {
                        "type": {
                            "$ref": "#/$defs/target_zone"
                        },
                        "size": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false
                },
                "description": {
                    "type": "string"
                }
            },
            "if": {
                "properties": {
                    "targeting": {
                        "const": "range"
                    }
                }
            },
            "then": {
                "required": [
                    "range"
                ]
            },
            "additionalProperties": false
        },
        "distance": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/distance.schema.json",
            "title": "D&D 5e Distance",
            "description": "A distance value and its unit.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "amount",
                "unit"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "minimum": 0
                },
                "unit": {
                    "$ref": "#/$defs/distance_type"
                }
            },
            "additionalProperties": false
        },
        "distance_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/distance_type.schema.json",
            "title": "D&D 5e Distance Unit",
            "description": "A unit used to describe a distance.",
            "$comment": "version 0.4.0",
            "type": "string",
            "enum": [
                "feet",
                "miles"
            ]
        },
        "target_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/target_type.schema.json",
            "title": "D&D 5e Target Type",
            "description": "The kind of creature or object that can be targeted.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "creature",
                        "ally",
                        "enemy",
                        "object",
                        "self"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "target_count": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/target_count.schema.json",
            "title": "D&D 5e Target Count",
            "description": "The number of targets an action or spell can affect.",
            "$comment": "version 0.4.0",
            "type": "object",
            "properties": {
                "minimum": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum": {
                    "type": "integer",
                    "minimum": 1
                },
                "all": {
                    "type": "boolean",
                    "const": true
                }
            },
            "oneOf": [
                {
                    "required": [
                        "all"
                    ],
                    "not": {
                        "anyOf": [
                            {
                                "required": [
                                    "minimum"
                                ]
                            },
                            {
                                "required": [
                                    "maximum"
                                ]
                            }
                        ]
                    }
                },
                {
                    "required": [
                        "minimum",
                        "maximum"
                    ]
                },
                {
                    "required": [
                        "minimum"
                    ],
                    "not": {
                        "required": [
                            "maximum"
                        ]
                    }
                },
                {
                    "required": [
                        "maximum"
                    ],
                    "not": {
                        "required": [
                            "minimum"
                        ]
                    }
                }
            ],
            "additionalProperties": false
        },
        "target_zone": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/target_zone.schema.json",
            "title": "D&D 5e Target Zone",
            "description": "The shape or scope of an action or spell's area.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "single",
                        "line",
                        "cone",
                        "cube",
                        "cylinder",
                        "sphere"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "spell_component": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/spell_component.schema.json",
            "title": "D&D 5e Spell Component",
            "description": "A required component to cast a spell.",
            "$comment": "version 0.4.0",
            "type": "string",
            "enum": [
                "verbal",
                "somatic",
                "material"
            ]
        },
        "material_component": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/material_component.schema.json",
            "title": "D&D 5e Material Component",
            "description": "The material component required to cast a spell.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "description"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "cost": {
                    "type": "number",
                    "minimum": 0
                },
                "consumed": {
                    "type": "boolean",
                    "default": false
                }
            },
            "additionalProperties": false
        },
        "duration_amount": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/duration_amount.schema.json",
            "title": "D&D 5e Duration Amount",
            "description": "A duration with an optional numeric amount, such as 8 hours or instantaneous.",
            "$comment": "version 0.5.0",
            "type": "object",
            "required": [
                "duration"
            ],
            "properties": {
                "amount": {
                    "type": "integer",
                    "minimum": 1
                },
                "duration": {
                    "$ref": "#/$defs/duration"
                }
            },
            "if": {
                "properties": {
                    "duration": {
                        "enum": [
                            "round",
                            "minute",
                            "hour",
                            "day",
                            "week",
                            "month",
                            "year"
                        ]
                    }
                },
                "required": [
                    "duration"
                ]
            },
            "then": {
                "required": [
                    "amount"
                ]
            },
            "else": {
                "if": {
                    "properties": {
                        "duration": {
                            "const": "instantaneous"
                        }
                    },
                    "required": [
                        "duration"
                    ]
                },
                "then": {
                    "not": {
                        "required": [
                            "amount"
                        ]
                    }
                }
            },
            "additionalProperties": false
        },
        "duration": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/duration.schema.json",
            "title": "D&D 5e Duration Unit",
            "description": "How long an effect lasts. Use recharge.schema.json for recovery timing.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "instantaneous",
                        "until_dispelled",
                        "until_saved",
                        "round",
                        "next_round",
                        "minute",
                        "hour",
                        "day",
                        "week",
                        "month",
                        "year"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "effect": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/effect.schema.json",
            "title": "D&D 5e Effect",
            "description": "An effect produced by an action, spell, feature, or attack.",
            "$comment": "version 0.5.0",
            "type": "object",
            "properties": {
                "damage": {
                    "$ref": "#/$defs/damage"
                },
                "healing": {
                    "$ref": "#/$defs/roll"
                },
                "max_hit_points": {
                    "$ref": "#/$defs/roll"
                },
                "temporary_hit_points": {
                    "$ref": "#/$defs/roll"
                },
                "ability_score": {
                    "$ref": "#/$defs/roll"
                },
                "exhaustion": {
                    "$ref": "#/$defs/roll"
                },
                "attack_hit": {
                    "$ref": "#/$defs/attack_hit"
                },
                "attack_save": {
                    "$ref": "#/$defs/attack_save"
                },
                "condition": {
                    "$ref": "#/$defs/condition"
                },
                "grants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/grant"
                    }
                },
                "description": {
                    "type": "string",
                    "input": "textarea"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "damage": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/damage.schema.json",
            "title": "D&D 5e Damage",
            "description": "A damage roll.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "type",
                "roll"
            ],
            "properties": {
                "type": {
                    "$ref": "#/$defs/damage_type"
                },
                "roll": {
                    "$ref": "#/$defs/roll"
                },
                "modifier": {
                    "type": "integer",
                    "default": 0
                },
                "ability": {
                    "$ref": "#/$defs/ability_score"
                }
            },
            "additionalProperties": false
        },
        "damage_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/damage_type.schema.json",
            "title": "D&D 5e Damage Type",
            "description": "A damage type.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "acid",
                        "bludgeoning",
                        "cold",
                        "fire",
                        "force",
                        "lightning",
                        "necrotic",
                        "piercing",
                        "poison",
                        "psychic",
                        "radiant",
                        "slashing",
                        "thunder"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "roll": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/roll.schema.json",
            "title": "D&D 5e Roll with Modifier",
            "description": "A dice roll with optional fixed and ability-based modifiers.",
            "$comment": "version 0.2.0",
            "type": "object",
            "properties": {
                "dice": {
                    "$ref": "#/$defs/dice"
                },
                "count": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                },
                "modifier": {
                    "type": "integer"
                },
                "ability": {
                    "$ref": "#/$defs/ability_score"
                }
            },
            "anyOf": [
                {
                    "required": [
                        "dice",
                        "count"
                    ]
                },
                {
                    "required": [
                        "modifier"
                    ]
                },
                {
                    "required": [
                        "ability"
                    ]
                }
            ],
            "additionalProperties": false
        },
        "dice": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/dice.schema.json",
            "title": "D&D 5e Dice",
            "description": "Polyhedral dice used in D&D 5e.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "integer",
                    "enum": [
                        4,
                        6,
                        8,
                        10,
                        12,
                        20,
                        100
                    ]
                },
                {
                    "$ref": "#/$defs/custom_int"
                }
            ]
        },
        "custom_int": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/custom_int.schema.json",
            "title": "Custom Int",
            "description": "A homebrew or otherwise non-canonical integer value.",
            "$comment": "version 0.4.0",
            "type": "integer"
        },
        "ability_score": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/ability_score.schema.json",
            "title": "D&D 5e Ability Score",
            "description": "One of the six D&D 5e ability scores.",
            "$comment": "version 0.4.0",
            "type": "string",
            "enum": [
                "strength",
                "dexterity",
                "constitution",
                "intelligence",
                "wisdom",
                "charisma"
            ]
        },
        "attack_hit": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/attack_hit.schema.json",
            "title": "D&D 5e Attack Hit",
            "description": "An attack roll used to determine whether an attack hits.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "$ref": "#/$defs/attack_type"
                },
                "bonus": {
                    "type": "integer",
                    "default": 0
                },
                "effects": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/effect"
                    }
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "attack_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/attack_type.schema.json",
            "title": "D&D 5e Attack Type",
            "description": "The kind of attack roll made against a target.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "melee_weapon",
                        "ranged_weapon",
                        "melee_spell",
                        "ranged_spell"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "attack_save": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/attack_save.schema.json",
            "title": "D&D 5e Saving Throw Effect",
            "description": "A saving throw used to determine whether an effect affects a target.",
            "$comment": "version 0.4.0",
            "type": "object",
            "required": [
                "ability"
            ],
            "properties": {
                "ability": {
                    "$ref": "#/$defs/ability_score"
                },
                "dc": {
                    "type": "integer",
                    "minimum": 1
                },
                "success": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/effect"
                    }
                },
                "failure": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/effect"
                    }
                }
            },
            "additionalProperties": false
        },
        "condition": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/condition.schema.json",
            "title": "D&D 5e Condition",
            "description": "A condition that can affect a creature.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "blinded",
                        "charmed",
                        "deafened",
                        "exhaustion",
                        "frightened",
                        "grappled",
                        "incapacitated",
                        "invisible",
                        "paralyzed",
                        "petrified",
                        "poisoned",
                        "prone",
                        "restrained",
                        "stunned",
                        "unconscious"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "grant": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/grant.schema.json",
            "title": "D&D 5e Grant",
            "description": "A non-numeric characteristic granted by an item or effect.",
            "$comment": "version 0.3.0",
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "advantage",
                        "disadvantage",
                        "resistance",
                        "vulnerability",
                        "immunity",
                        "sense",
                        "movement"
                    ]
                },
                "ability_check": {
                    "$ref": "#/$defs/ability_score"
                },
                "skill": {
                    "$ref": "#/$defs/skill"
                },
                "saving_throw": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/ability_score"
                        },
                        {
                            "$ref": "#/$defs/condition"
                        }
                    ]
                },
                "condition": {
                    "$ref": "#/$defs/condition"
                },
                "damage_type": {
                    "$ref": "#/$defs/damage_type"
                },
                "sense": {
                    "$ref": "#/$defs/sense_type"
                },
                "distance": {
                    "type": "integer",
                    "minimum": 0
                },
                "movement_type": {
                    "$ref": "#/$defs/movement_type"
                },
                "description": {
                    "type": "string",
                    "input": "textarea"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": [
                                    "resistance",
                                    "vulnerability",
                                    "immunity"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "damage_type"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "sense"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "sense",
                            "distance"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "movement"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "movement_type",
                            "distance"
                        ]
                    }
                }
            ],
            "additionalProperties": false
        },
        "skill": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/skill.schema.json",
            "title": "D&D 5e Skill",
            "description": "A skill.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "acrobatics",
                        "animal_handling",
                        "arcana",
                        "athletics",
                        "deception",
                        "history",
                        "insight",
                        "intimidation",
                        "investigation",
                        "medicine",
                        "nature",
                        "perception",
                        "performance",
                        "persuasion",
                        "religion",
                        "sleight_of_hand",
                        "stealth",
                        "survival"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "sense_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/sense_type.schema.json",
            "title": "D&D 5e Sense Type",
            "description": "A type of special sense.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "blindsight",
                        "darkvision",
                        "devil_sight",
                        "tremorsense",
                        "truesight"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "movement_type": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/movement_type.schema.json",
            "title": "D&D 5e Movement Type",
            "description": "A type of movement. Hover is a flag on fly speed, not its own type.",
            "$comment": "version 0.4.0",
            "anyOf": [
                {
                    "type": "string",
                    "enum": [
                        "walk",
                        "fly",
                        "swim",
                        "climb",
                        "burrow"
                    ]
                },
                {
                    "$ref": "#/$defs/custom_value"
                }
            ]
        },
        "roll_table": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/roll_table.schema.json",
            "title": "D&D 5e Roll Table",
            "description": "A table of outcomes determined by a dice roll.",
            "$comment": "version 0.3.0",
            "type": "object",
            "required": [
                "dice",
                "entries"
            ],
            "properties": {
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "dice": {
                    "$ref": "#/$defs/dice"
                },
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/roll_table_entry"
                    },
                    "minItems": 1
                }
            },
            "additionalProperties": false
        },
        "roll_table_entry": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "components/roll_table_entry.schema.json",
            "title": "D&D 5e Roll Table Entry",
            "description": "An outcome corresponding to a roll result.",
            "$comment": "version 0.3.0",
            "type": "object",
            "required": [
                "roll",
                "result"
            ],
            "properties": {
                "roll": {
                    "type": "integer",
                    "minimum": 1
                },
                "result": {
                    "type": "string",
                    "minLength": 1
                },
                "effects": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/effect"
                    },
                    "minItems": 1
                }
            },
            "additionalProperties": false
        },
        "tag": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/tag.schema.json",
            "title": "Tag",
            "description": "A free-form tag used to categorise data.",
            "$comment": "version 0.4.0",
            "type": "string",
            "minLength": 1,
            "examples": [
                "wizard",
                "bronze_dragon",
                "orc"
            ]
        },
        "source": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "$id": "values/source.schema.json",
            "title": "Data Source",
            "description": "The source from which the data was obtained.",
            "$comment": "version 0.4.0",
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "description": "Human-readable reference to the source.",
                    "examples": [
                        "PHB p41",
                        "Unearthed Arcana: The Artificer Revisited"
                    ]
                },
                "note": {
                    "type": "string",
                    "description": "Additional information about the source.",
                    "input": "textarea"
                },
                "href": {
                    "type": "string",
                    "format": "uri",
                    "description": "A URI linking to the source.",
                    "examples": [
                        "https://media.wizards.com/2019/dnd/downloads/UA-Artificer-2019.pdf"
                    ]
                }
            },
            "anyOf": [
                {
                    "required": [
                        "text"
                    ]
                },
                {
                    "required": [
                        "href"
                    ]
                }
            ],
            "additionalProperties": false
        }
    }
}
