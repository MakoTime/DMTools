{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/duration_amount.schema.json",
    "title": "D&D 5e Duration Amount",
    "description": "A duration with an optional numeric amount, such as 8 hours or instantaneous.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "duration"
    ],
    "properties": {
        "amount": {
            "type": "integer",
            "minimum": 1
        },
        "duration": {
            "$ref": "../values/duration.schema.json"
        }
    },
    "if": {
        "properties": {
            "duration": {
                "enum": [
                    "round",
                    "minute",
                    "hour",
                    "day",
                    "week",
                    "month",
                    "year"
                ]
            }
        },
        "required": [
            "duration"
        ]
    },
    "then": {
        "required": [
            "amount"
        ]
    },
    "additionalProperties": false
}
