{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "duration_amount.schema.json",
    "title": "JSON Schema for D&D 5e Duration Amount",
    "description": "This schema describes a D&D 5e duration amount.",
    "$comment": "version 0.2.0",
    "type": "object",
    "properties": {
        "amount": {
            "type": "integer",
            "minimum": 0
        },
        "duration": {
            "$ref": "../values/duration.schema.json"
        }
    },
    "required": ["amount", "duration"]
}