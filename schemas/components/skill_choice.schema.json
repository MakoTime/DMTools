{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/skill_choice.schema.json",
    "title": "D&D 5e Skill Choice",
    "description": "A choice of skills from a defined list, such as a class's skill proficiency picks.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "choose",
        "from"
    ],
    "properties": {
        "choose": {
            "type": "integer",
            "minimum": 1
        },
        "from": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "../values/skill.schema.json"
            },
            "uniqueItems": true
        }
    },
    "additionalProperties": false
}
