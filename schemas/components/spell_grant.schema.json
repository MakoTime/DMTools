{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/spell_grant.schema.json",
    "title": "D&D 5e Spell Grant",
    "description": "Spells granted by a class, subclass, race, background, or feat, including guaranteed spells and choices.",
    "$comment": "version 0.4.0",
    "type": "object",
    "properties": {
        "spells": {
            "description": "Specific spell names guaranteed by the grant.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "choices": {
            "description": "Choices of spells available through the grant.",
            "type": "array",
            "items": {
                "$ref": "spell_choice.schema.json"
            },
            "minItems": 1
        },
        "casting_ability": {
            "description": "The ability used to cast spells granted by this grant.",
            "oneOf": [
                {
                    "$ref": "../values/ability_score.schema.json"
                },
                {
                    "type": "string",
                    "enum": [
                        "ability_score_choice"
                    ]
                }
            ]
        },
        "uses": {
            "description": "Times the granted spells can be cast without expending a spell slot.",
            "type": "integer",
            "minimum": 1
        },
        "recharge": {
            "description": "When the granted spells' uses are restored.",
            "$ref": "../values/recharge.schema.json"
        }
    },
    "anyOf": [
        {
            "required": [
                "spells"
            ]
        },
        {
            "required": [
                "choices"
            ]
        }
    ],
    "additionalProperties": false
}
