{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/feature.schema.json",
    "title": "D&D 5e Feature",
    "description": "A feature or trait granted by a class, subclass, race, background, feat, or other game element.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "name",
        "description"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "input": "textarea"
        },
        "level": {
            "description": "Class or subclass level at which this feature is gained.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
        },
        "source": {
            "$ref": "../values/source.schema.json"
        }
    },
    "additionalProperties": false
}
