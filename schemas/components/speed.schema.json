{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/speed.schema.json",
    "title": "D&D 5e Speed",
    "description": "A distance and unit of movement.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "distance",
        "unit"
    ],
    "properties": {
        "distance": {
            "type": "integer",
            "minimum": 0
        },
        "unit": {
            "$ref": "../values/distance_type.schema.json"
        }
    },
    "additionalProperties": false
}
