{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "sense.schema.json",
    "title": "D&D 5e Sense",
    "description": "A special sense and its effective range.",
    "$comment": "version 0.2.0",
    "type": "object",
    "required": [
        "type",
        "distance"
    ],
    "properties": {
        "type": {
            "$ref": "sense_type.schema.json"
        },
        "distance": {
            "type": "integer",
            "minimum": 0
        },
        "distance_type": {
            "$ref": "distance_type.schema.json"
        }
    },
    "additionalProperties": false
}