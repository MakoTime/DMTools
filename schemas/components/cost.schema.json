{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/cost.schema.json",
    "title": "D&D 5e Cost",
    "description": "A cost for an item.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "amount",
        "currency"
    ],
    "properties": {
        "amount": {
            "type": "integer",
            "minimum": 1
        },
        "currency": {
            "$ref": "../values/currency.schema.json"
        }
    },
    "additionalProperties": false
}
