{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/ability_score_increase.schema.json",
    "title": "D&D 5e Ability Score Increase",
    "description": "An ability score increase: a fixed ability, or a choice from a list.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "amount"
    ],
    "properties": {
        "amount": {
            "type": "integer",
            "minimum": 1,
            "default": 1
        },
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        },
        "choices": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "../values/ability_score.schema.json"
            },
            "uniqueItems": true
        }
    },
    "oneOf": [
        {
            "required": [
                "ability"
            ],
            "not": {
                "required": [
                    "choices"
                ]
            }
        },
        {
            "required": [
                "choices"
            ],
            "not": {
                "required": [
                    "ability"
                ]
            }
        }
    ],
    "additionalProperties": false
}
