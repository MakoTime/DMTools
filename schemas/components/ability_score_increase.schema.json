{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/ability_score_increase.schema.json",
    "title": "D&D 5e Ability Score Increase",
    "description": "An increase to an ability score.",
    "$comment": "version 0.5.0",
    "type": "object",
    "required": [
        "ability",
        "amount"
    ],
    "properties": {
        "ability": {
            "oneOf": [
                {
                    "$ref": "../values/ability_score.schema.json"
                },
                {
                    "$ref": "ability_score_choice.schema.json"
                }
            ]
        },
        "amount": {
            "type": "integer",
            "minimum": 1
        }
    },
    "additionalProperties": false
}