{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/roll.schema.json",
    "title": "D&D 5e Roll with Modifier",
    "description": "A dice roll with optional fixed and ability-based modifiers.",
    "$comment": "version 0.2.0",
    "type": "object",
    "properties": {
        "dice": {
            "$ref": "../values/dice.schema.json"
        },
        "count": {
            "type": "integer",
            "minimum": 1,
            "default": 1
        },
        "modifier": {
            "type": "integer"
        },
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        }
    },
    "anyOf": [
        {
            "required": [
                "dice",
                "count"
            ]
        },
        {
            "required": [
                "modifier"
            ]
        },
        {
            "required": [
                "ability"
            ]
        }
    ],
    "additionalProperties": false
}