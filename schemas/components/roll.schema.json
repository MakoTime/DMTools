{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/roll.schema.json",
    "title": "D&D 5e Dice Roll",
    "description": "A dice roll.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "dice"
    ],
    "properties": {
        "dice": {
            "$ref": "../values/die.schema.json"
        },
        "count": {
            "type": "integer",
            "minimum": 1,
            "default": 1
        },
        "modifier": {
            "type": "integer",
            "default": 0
        }
    },
    "additionalProperties": false
}
