{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/target.schema.json",
    "title": "D&D 5e Target",
    "description": "A target specification for an action or spell.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "type"
    ],
    "properties": {
        "type": {
            "type": "string",
            "enum": [
                "self",
                "touch",
                "range"
            ]
        },
        "range": {
            "type": "integer",
            "minimum": 0
        },
        "target": {
            "$ref": "../values/target_type.schema.json"
        },
        "count": {
            "$ref": "target_count.schema.json"
        },
        "zone": {
            "type": "object",
            "required": [
                "type",
                "size"
            ],
            "properties": {
                "type": {
                    "$ref": "../values/target_zone.schema.json"
                },
                "size": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "description": {
            "type": "string"
        }
    },
    "if": {
        "properties": {
            "type": {
                "const": "range"
            }
        },
        "required": [
            "type"
        ]
    },
    "then": {
        "required": [
            "range"
        ]
    },
    "additionalProperties": false
}
