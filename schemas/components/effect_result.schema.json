{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/effect_result.schema.json",
    "title": "D&D 5e Effect Result",
    "description": "The outcome of a hit, a failed save, or a successful save. Does not nest further attacks.",
    "$comment": "version 0.4.0",
    "type": "object",
    "properties": {
        "damage": {
            "$ref": "damage.schema.json"
        },
        "condition": {
            "$ref": "../values/condition.schema.json"
        },
        "description": {
            "type": "string",
            "input": "textarea"
        }
    },
    "minProperties": 1,
    "additionalProperties": false
}
