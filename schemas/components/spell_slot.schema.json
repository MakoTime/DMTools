{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "spell_slot.schema.json",
    "title": "D&D 5e Spell Slot",
    "description": "A spell slot for a D&D 5e spell level.",
    "$comment": "version 0.2.0",
    "type": "object",
    "required": [
        "level",
        "maximum"
    ],
    "properties": {
        "level": {
            "$ref": "../values/spell_level.schema.json"
        },
        "maximum": {
            "type": "integer",
            "minimum": 0
        },
        "current": {
            "type": "integer",
            "minimum": 0
        },
        "recharge": {
            "$ref": "../values/duration.schema.json"
        }
    },
    "additionalProperties": false
}