{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/saving_throws.schema.json",
    "title": "D&D 5e Saving Throw Modifiers",
    "description": "Saving throw modifiers for the six ability scores on a creature in play.",
    "$comment": "version 0.4.0",
    "type": "object",
    "properties": {
        "strength": {
            "type": "integer"
        },
        "dexterity": {
            "type": "integer"
        },
        "constitution": {
            "type": "integer"
        },
        "intelligence": {
            "type": "integer"
        },
        "wisdom": {
            "type": "integer"
        },
        "charisma": {
            "type": "integer"
        }
    },
    "additionalProperties": false
}
