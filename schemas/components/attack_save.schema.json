{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/attack_save.schema.json",
    "title": "D&D 5e Saving Throw Effect",
    "description": "A saving throw used to determine whether an effect affects a target.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "ability"
    ],
    "properties": {
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        },
        "dc": {
            "type": "integer",
            "minimum": 1
        },
        "success": {
            "type": "array",
            "items": {
                "$ref": "effect.schema.json"
            }
        },
        "failure": {
            "type": "array",
            "items": {
                "$ref": "effect.schema.json"
            }
        }
    },
    "additionalProperties": false
}
