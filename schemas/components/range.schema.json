{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/range.schema.json",
    "title": "D&D 5e Range",
    "description": "The normal and long range of an attack or weapon, in feet.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "normal"
    ],
    "properties": {
        "normal": {
            "type": "integer",
            "minimum": 0
        },
        "long": {
            "type": "integer",
            "minimum": 0
        }
    },
    "additionalProperties": false
}
