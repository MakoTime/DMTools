{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/spellcasting.schema.json",
    "title": "D&D 5e Class Spellcasting",
    "description": "Spellcasting granted by a class definition.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "ability",
        "progression"
    ],
    "properties": {
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        },
        "progression": {
            "$ref": "../values/spellcasting_progression.schema.json"
        },
        "ritual": {
            "type": "boolean",
            "default": false
        },
        "prepared": {
            "description": "Whether the class prepares spells rather than knowing a fixed list.",
            "type": "boolean",
            "default": false
        },
        "spells": {
            "$ref": "spell_grant.schema.json"
        }
    },
    "additionalProperties": false
}
