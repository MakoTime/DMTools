{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "material_component.schema.json",
    "title": "D&D 5e Material Component",
    "description": "The material component required to cast a D&D 5e spell.",
    "$comment": "version 0.2.0",
    "type": "object",
    "required": [
        "description"
    ],
    "properties": {
        "description": {
            "type": "string"
        },
        "cost": {
            "type": "number",
            "minimum": 0
        },
        "consumed": {
            "type": "boolean",
            "default": false
        }
    },
    "additionalProperties": false
}