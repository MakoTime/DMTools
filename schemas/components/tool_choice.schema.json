{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/tool_choice.schema.json",
    "title": "D&D 5e Tool Choice",
    "description": "A choice of tools, instruments, kits, or gaming sets from a defined list.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "choose",
        "from"
    ],
    "properties": {
        "choose": {
            "type": "integer",
            "minimum": 1
        },
        "from": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "../values/tool.schema.json"
            },
            "uniqueItems": true
        }
    },
    "additionalProperties": false
}