{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/magic_item.schema.json",
    "title": "D&D 5e Magic Item",
    "description": "Magical properties granted by an item.",
    "$comment": "version 0.1.0",
    "type": "object",
    "properties": {
        "attunement": {
            "type": "boolean",
            "default": false
        },
        "bonuses": {
            "type": "array",
            "items": {
                "$ref": "bonus.schema.json"
            }
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "effect.schema.json"
            }
        },
        "rarity": {
            "$ref": "../values/rarity.schema.json"
        },
        "charges": {
            "$ref": "magic_item_charges.schema.json"
        },
        "spells": {
            "type": "array",
            "items": {
                "$ref": "spell_charge.schema.json"
            }
        },
        "roll_table": {
            "$ref": "roll_table.schema.json"
        },
        "grants": {
            "type": "array",
            "items": {
                "$ref": "grant.schema.json"
            }
        }
    },
    "additionalProperties": false
}