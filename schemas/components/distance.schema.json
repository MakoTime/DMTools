{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/distance.schema.json",
    "title": "D&D 5e Distance",
    "description": "A distance value and its unit.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "amount",
        "unit"
    ],
    "properties": {
        "amount": {
            "type": "integer",
            "minimum": 0
        },
        "unit": {
            "$ref": "../values/distance_type.schema.json",
            "default": "feet"
        }
    },
    "additionalProperties": false
}
