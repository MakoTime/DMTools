{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/spellcasting.schema.json",
    "title": "D&D 5e Spellcasting",
    "description": "A creature's spellcasting abilities and spells.",
    "$comment": "version 0.1.0",
    "type": "object",
    "properties": {
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        },
        "save_dc": {
            "type": "integer",
            "minimum": 1
        },
        "attack_bonus": {
            "type": "integer"
        },
        "spells_known": {
            "$ref": "spells_known.schema.json"
        }
    },
    "additionalProperties": false
}