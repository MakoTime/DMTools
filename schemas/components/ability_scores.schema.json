{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/ability_scores.schema.json",
    "title": "D&D 5e Ability Scores",
    "description": "The six ability scores of a creature.",
    "$comment": "version 0.4.0",
    "type": "object",
    "properties": {
        "strength": {
            "type": "integer",
            "minimum": 1
        },
        "dexterity": {
            "type": "integer",
            "minimum": 1
        },
        "constitution": {
            "type": "integer",
            "minimum": 1
        },
        "intelligence": {
            "type": "integer",
            "minimum": 1
        },
        "wisdom": {
            "type": "integer",
            "minimum": 1
        },
        "charisma": {
            "type": "integer",
            "minimum": 1
        }
    },
    "required": [
        "strength",
        "dexterity",
        "constitution",
        "intelligence",
        "wisdom",
        "charisma"
    ],
    "additionalProperties": false
}
