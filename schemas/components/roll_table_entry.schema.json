{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/roll_table_entry.schema.json",
    "title": "D&D 5e Roll Table Entry",
    "description": "An outcome corresponding to a roll result.",
    "$comment": "version 0.3.0",
    "type": "object",
    "required": [
        "roll",
        "result"
    ],
    "properties": {
        "roll": {
            "type": "integer",
            "minimum": 1
        },
        "result": {
            "type": "string",
            "minLength": 1
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "effect_result.schema.json"
            },
            "minItems": 1
        }
    },
    "additionalProperties": false
}