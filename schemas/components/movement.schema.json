{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/movement.schema.json",
    "title": "D&D 5e Movement",
    "description": "A creature's speed for one movement type. Hover is a flag on fly speed.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "movement_type",
        "speed"
    ],
    "properties": {
        "movement_type": {
            "$ref": "../values/movement_type.schema.json"
        },
        "speed": {
            "$ref": "speed.schema.json"
        },
        "hover": {
            "type": "boolean",
            "default": false
        }
    },
    "additionalProperties": false
}
