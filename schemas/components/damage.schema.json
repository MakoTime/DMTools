{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/damage.schema.json",
    "title": "D&D 5e Damage",
    "description": "A damage roll.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "type",
        "roll"
    ],
    "properties": {
        "type": {
            "$ref": "../values/damage_type.schema.json"
        },
        "roll": {
            "$ref": "roll.schema.json"
        },
        "modifier": {
            "type": "integer",
            "default": 0
        },
        "ability": {
            "$ref": "../values/ability_score.schema.json"
        }
    },
    "additionalProperties": false
}
