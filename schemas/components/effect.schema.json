{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/effect.schema.json",
    "title": "D&D 5e Effect",
    "description": "An effect produced by an action, spell, feature, or attack.",
    "$comment": "version 0.4.0",
    "type": "object",
    "properties": {
        "damage": {
            "$ref": "damage.schema.json"
        },
        "attack_hit": {
            "$ref": "attack_hit.schema.json"
        },
        "attack_save": {
            "$ref": "attack_save.schema.json"
        },
        "condition": {
            "$ref": "../values/condition.schema.json"
        },
        "description": {
            "type": "string",
            "input": "textarea"
        }
    },
    "minProperties": 1,
    "additionalProperties": false
}
