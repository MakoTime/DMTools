{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/weapon.schema.json",
    "title": "D&D 5e Weapon",
    "description": "The weapon properties of an item.",
    "$comment": "version 0.1.0",
    "type": "object",
    "properties": {
        "type": {
            "$ref": "../values/weapon_type.schema.json"
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "effect.schema.json"
            },
            "minItems": 1
        },
        "properties": {
            "type": "array",
            "items": {
                "$ref": "../values/weapon_property.schema.json"
            },
            "uniqueItems": true
        },
        "range": {
            "$ref": "range.schema.json"
        }
    },
    "additionalProperties": false
}