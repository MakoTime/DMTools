{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "components/attack_hit.schema.json",
    "title": "D&D 5e Attack Hit",
    "description": "An attack roll used to determine whether an attack hits.",
    "$comment": "version 0.4.0",
    "type": "object",
    "required": [
        "type"
    ],
    "properties": {
        "type": {
            "$ref": "../values/attack_type.schema.json"
        },
        "bonus": {
            "type": "integer",
            "default": 0
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "effect.schema.json"
            }
        }
    },
    "minProperties": 1,
    "additionalProperties": false
}
